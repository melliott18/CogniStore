      ]
    },
    {
      "id": 6,
      "title": "Throughput window result",
      "type": "timeseries",
      "description": "1 = eligible window met floor; 0 = eligible window missed floor; gap = ineligible/unknown. Fully stalled movers age out of eligibility; investigate queue-capacity and telemetry alerts alongside this SLI.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
