    },
    {
      "id": 5,
      "title": "Completed successful moves \u00b7 5m rate",
      "type": "timeseries",
      "description": "Floor 1 successful move/s. Throughput SLO samples overlapping 5m windows every 15s only when pending backlog remained positive and some move attempts completed. It does not infer move demand from scan-only backlog.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
