        {
          "refId": "A",
          "expr": "cognistore:move_throughput_good",
          "legendFormat": "eligible window result",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Cost/carbon budget consumption",
      "type": "timeseries",
      "description": "Maximum consumption of an active independently enforced policy/tier/window budget scope, including reservations. No configured limit is 0; any unknown required scope is NaN. A zero limit with consumption is +Inf.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
