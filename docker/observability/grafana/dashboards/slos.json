{
  "id": null,
  "uid": "cognistore-slos",
  "title": "CogniStore \u00b7 SLOs and operational guardrails",
  "description": "Rolling 30-day SLOs, error budgets, burn alerts, policy budgets and capacity. Missing observations are unknown. Review the runbook for eligibility, partial history and notification setup.",
  "tags": [
    "cognistore",
    "slo",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "SLO definitions and runbooks",
      "type": "link",
      "url": "https://github.com/melliott18/CogniStore/blob/main/docs/operational_slos.md",
      "targetBlank": true
    },
    {
      "title": "Detailed operations dashboard",
      "type": "link",
      "url": "/d/cognistore-operations",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "SLI attainment \u00b7 rolling 30 days",
      "type": "timeseries",
      "description": "Move success/API availability targets 99.9%; move latency <=30s, indexing lag <=300s, and eligible throughput windows >=1 move/s targets 99%. NaN/missing means no observations, not 100%. Before 30 days have been retained these are partial-history values.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - cognistore:slo_bad_ratio{window=\"30d\"}",
          "legendFormat": "{{slo}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Error budget consumed \u00b7 rolling 30 days",
      "type": "timeseries",
      "description": "Observed bad fraction / (1 - target). Values above 100% mean the rolling budget is exhausted; overspend is preserved. With no observations consumption is unknown. All series use the same rolling 30-day accounting window.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - cognistore:slo_budget_remaining_ratio",
          "legendFormat": "{{slo}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Fast burn \u00b7 5m / 1h",
      "type": "timeseries",
      "description": "Critical alert: both 5m and 1h windows exceed 14.4x for 2m. Burn 1 consumes budget at exactly the allowed long-run rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cognistore:slo_burn_rate{window=~\"5m|1h\"}",
          "legendFormat": "{{slo}} \u00b7 {{window}}",
          "range": true
        }
      ]
    },
