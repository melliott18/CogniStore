      "targets": [
        {
          "refId": "A",
          "expr": "cognistore:policy_budget_consumption_ratio",
          "legendFormat": "{{dimension}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Budget scopes with unknown accounting",
      "type": "timeseries",
      "description": "Unknown budget telemetry never implies free capacity. Check scope coverage, active time windows, and catalog connectivity. Counts can repeat across API replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
