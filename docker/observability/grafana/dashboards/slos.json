      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"cognistore-worker|cognistore-api\"}",
          "legendFormat": "{{job}} \u00b7 {{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Firing operational alerts",
      "type": "timeseries",
      "description": "Prometheus evaluates these rules locally. Configure Alertmanager routing for production notifications; this local profile does not send notifications.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
