        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dimension) (cognistore_policy_budget_unknown)",
          "legendFormat": "{{dimension}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Broker queue backlog",
      "type": "timeseries",
      "description": "Maximum across worker replicas reporting the same durable consumer avoids double-counting. Pending >10,000 for 10m warns. NaN means broker health is unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (cognistore_job_queue_depth)",
          "legendFormat": "{{state}}",
          "range": true
