    {
      "id": 10,
      "title": "Indexing observations excluded \u00b7 5m",
      "type": "timeseries",
      "description": "Completed scan attempts with missing, invalid, or future original publication time are excluded from indexing SLI and produce a data-quality alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
