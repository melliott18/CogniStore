      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cognistore_indexing_lag_unknown_total[5m]))",
          "legendFormat": "unknown timestamps",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "Telemetry scrape health",
      "type": "timeseries",
      "description": "1 = scrape succeeded; 0 = scrape failed. Absent/failed targets alert after 5m. Missing history must not be read as compliance.",
      "datasource": {
        "type": "prometheus",
        "uid": "cognistore-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
