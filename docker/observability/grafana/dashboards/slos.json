        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",alertname=~\"CogniStore.*\"}",
          "legendFormat": "{{alertname}} \u00b7 {{slo}} {{dimension}} {{job}}",
          "range": true
